[Unit]
Description=E-Eye Photorefractor Operator Web Interface
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
SupplementaryGroups=video gpio i2c render
WorkingDirectory=/opt/eeye/current
EnvironmentFile=/etc/eeye/device.env
Environment="PYTHONUNBUFFERED=1"
Environment="EEYE_MOCK=0"
ExecStart=/opt/eeye/current/.venv/bin/gunicorn -c deploy/gunicorn.conf.py app.app:app
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
